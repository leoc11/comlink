{
  "name": "comlink",
  "version": "4.4.2",
  "description": "Comlink makes WebWorkers enjoyable",
  "main": "dist/cjs/comlink.js",
  "module": "dist/esm/comlink.mjs",
  "types": "dist/esm/comlink.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:mjs && bun run build:mjs.min && bun run build:mjs.type && bun run build:cjs && bun run build:cjs.min && bun run build:cjs.type",
    "build:mjs": "bun build ./src/comlink.ts --outdir=dist/esm --sourcemap=linked --target=node --format=esm --entry-naming=[dir]/[name].mjs",
    "build:mjs.min": "bun build ./src/comlink.ts --outdir=dist/esm --sourcemap=linked --target=node --format=esm --minify --entry-naming=[dir]/[name].min.mjs",
    "build:mjs.type": "bunx tsc --emitDeclarationOnly --skipLibCheck --outDir dist/esm",
    "build:cjs": "bun build ./src/comlink.ts --outdir=dist/cjs --sourcemap=linked --target=node --format=cjs",
    "build:cjs.min": "bun build ./src/comlink.ts --outdir=dist/cjs --sourcemap=linked --target=node --format=cjs --minify --entry-naming=[dir]/[name].min.[ext]",
    "build:cjs.type": "bunx tsc --emitDeclarationOnly --skipLibCheck --outDir dist/cjs",
    "test": "bun run test:unit && bun run test:type && bun run test:fmt",
    "test:type": "bunx tsc -p tsconfig.test.json",
    "test:unit": "bun test ./tests --coverage",
    "test:fmt": "prettier --check './*.{mjs,js,ts,md,json,html}' './{src,docs,tests}/{,**/}*.{mjs,js,ts,md,json,html}'",
    "fmt": "prettier --write './*.{mjs,js,ts,md,json,html}' './{src,docs,tests}/{,**/}*.{mjs,js,ts,md,json,html}'"
  },
  "author": {
    "name": "Leo Chandra",
    "email": "leo.chandra11@google.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleChromeLabs/comlink.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "web-locks": "^0.0.9"
  }
}
